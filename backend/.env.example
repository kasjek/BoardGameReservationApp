# Copy to .env for local development.
# When DATABASE_URL is unset, the app falls back to SQLite (no server needed).
DATABASE_URL=postgres://boardgame:boardgame@localhost:5432/boardgame
DJANGO_SECRET_KEY=dev-insecure-key-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
# Google Identity Services web client ID (OAuth 2.0). Empty = hide Google button.
# Authorized JavaScript origins must include this site (and http://localhost:3000 for local).
GOOGLE_CLIENT_ID=
# Facebook Login. Empty = hide Facebook button. Both required to verify tokens.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Google reCAPTCHA v2 checkbox (required for POST /auth/register in production).
# Leave empty in DEBUG to use Google's always-pass test keys.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# SMTP for activation emails. Empty = console backend in DEBUG; production
# without EMAIL_HOST rejects password registration.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Too Many Games <noreply@localhost>
# Public site origin used in activation links (no trailing slash).
PUBLIC_APP_URL=http://127.0.0.1:3000
