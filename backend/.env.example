# Copy to .env for local development.
# When DATABASE_URL is unset, the app falls back to SQLite (no server needed).
DATABASE_URL=postgres://boardgame:boardgame@localhost:5432/boardgame
DJANGO_SECRET_KEY=dev-insecure-key-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
# Google Identity Services web client ID (OAuth 2.0). Empty = hide Google button.
# Authorized JavaScript origins must include this site (and http://localhost:3000 for local).
GOOGLE_CLIENT_ID=
# Google reCAPTCHA v2 checkbox (required for POST /auth/register in production).
# Leave empty in DEBUG to use Google's always-pass test keys.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
