# GoDaddy Node app environment / secrets
# Upload this in the GoDaddy secrets/env UI (or rename to .env next to package.json
# if your host loads .env automatically).
#
# REQUIRED — replace with your LIVE Django API origin or login/register will fail:
BACKEND_URL=https://REPLACE-WITH-YOUR-DJANGO-API-HOST

# Optional — only if GoDaddy does not inject PORT itself:
# PORT=3000

# Do NOT set HOSTNAME.
# Optional bind override (normally leave unset):
# HOST=0.0.0.0
